# Postgres (Supabase : Project Settings > Database > Connection string, mode pooler/transaction conseillé sur Vercel)
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# GESTO_DATA_KEY=   (OBLIGATOIRE en production : chiffre les données salariés — ne jamais la perdre ni la changer)
# GESTO_SESSION_SECRET=   (OBLIGATOIRE en production)
# Aucune clé dans le code. Copier vers .env.local (jamais commité).
# Test local uniquement. Ignoré si NODE_ENV=production. Ne jamais le poser sur Vercel.
# GESTO_DEMO=1
# Boîte d'équipe (Auth + RLS). Tant que ces deux lignes sont vides, /le-chamois reste en mode démo locale.
# Ne jamais mettre la clé service_role ici, ni dans NEXT_PUBLIC_.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Les invitations par e-mail ne partent pas toutes seules. Il faut le SMTP de Supabase Auth, ou un autre fournisseur. Sans ça, le lien se copie à la main.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RESEND_API_KEY=

# Notifications système (Web Push) — générer : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ton-adresse
# Rappels quotidiens : appeler GET /api/rappels avec Authorization: Bearer $CRON_SECRET
# CRON_SECRET=
# GESTO_SESSION_SECRET=
# GESTO_DATA_KEY=
